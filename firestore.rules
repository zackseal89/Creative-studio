rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Blueprint Structural Validator preventing Update-Gaps and Value Poisoning
    function isValidProject(data) {
      return data.projectId is string && data.projectId.size() <= 128
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.topic is string && data.topic.size() <= 1000
        && data.phase is string && data.phase.size() <= 64
        && (data.script == null || (data.script is string && data.script.size() <= 1048576))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /projects/{projectId} {
      // Path Variable Poisoning check for get
      allow get: if isEmailVerified() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      
      // Query Enforcer - Client MUST formulate a safe query targeting only their projects
      allow list: if isEmailVerified() && resource.data.ownerId == request.auth.uid;

      allow create: if isEmailVerified() && isValidId(projectId)
        && incoming().projectId == projectId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isValidProject(incoming());

      allow update: if isEmailVerified() && isValidId(projectId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isValidProject(incoming())
        && (
          // Authorized payload update paths
          incoming().diff(existing()).affectedKeys().hasOnly([
            'topic', 'phase', 'research', 'selectedHookIndex', 'plan', 'script', 'logs', 'updatedAt'
          ])
        );

      allow delete: if isEmailVerified() && isValidId(projectId) && existing().ownerId == request.auth.uid;
    }
  }
}
